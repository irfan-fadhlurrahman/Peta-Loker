# Copy to .env and fill in. .env is gitignored — never commit real values.

# Keyed hash for company pseudonyms (any long random string; keep it stable,
# changing it changes every company id). e.g. python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=

# SQLite database path (default: data/peta_loker.db)
DB_PATH=

# Raw page store: tos (BytePlus TOS) or local (data/raw/). Unset = tos when the
# TOS_* values below are filled in, otherwise local.
RAW_STORE=

# BytePlus TOS (Torch Object Storage). The bucket must be private, with a
# lifecycle rule deleting objects after ~90 days.
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET_NAME=

# BytePlus ModelArk (OpenAI-compatible chat completions), Seed 2.0 Lite
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=
